# HTTPS entry point for the Telegram Mini App.
#
# Caddy obtains and renews the Let's Encrypt certificate for $WEBAPP_DOMAIN
# automatically (HTTP-01 challenge, so port 80 must be reachable from the
# internet) and proxies everything to the bot container, which also serves the
# Mini App and its JSON API on :8080.
#
# The default value of $WEBAPP_DOMAIN keeps the file valid when the variable
# is not set at all: an empty site address would be parsed as a global options
# block and Caddy would refuse to start. With no domain configured the site is
# a local placeholder and the Mini App stays unpublished in Telegram.

{$WEBAPP_DOMAIN:localhost} {
	encode zstd gzip

	reverse_proxy bot:8080

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	log {
		output stdout
		format console
	}
}
