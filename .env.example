# ===== Required =====
# Bot token from @BotFather (see README).
TELEGRAM_BOT_TOKEN=

# ===== Canvas =====
# Canvas API token (Canvas -> Account -> Settings -> New Access Token).
# OPTIONAL: leave it empty and connect Canvas inside the chat with /setup:
# the bot verifies the token, stores it per chat (sealed) and reuses it after
# restarts. When set here, this token is authoritative for the background sync
# and chat tokens are not used for it.
CANVAS_API_TOKEN=

# Optional secret that encrypts chat-entered Canvas tokens at rest
# (AES-256-GCM, key = SHA-256 of this value). Empty = tokens are only
# base64-obfuscated in the database. Set it for VDS deployments.
CANVAS_TOKEN_SECRET=

# Canvas instance (defaults shown).
CANVAS_BASE_URL=https://canvas.narxoz.kz

# Optional proxy for Canvas traffic only (Telegram is unaffected). Needed when
# the host running the bot cannot reach the Canvas instance, e.g. a VDS whose
# datacenter IP is blocked by the university. Accepts http(s):// and socks5://.
# CANVAS_PROXY=socks5://127.0.0.1:1080

# ===== Optional =====
# Primary chat id that receives notifications. If empty, every chat that
# presses /start is treated as a subscriber and receives notifications.
# You can learn your id by messaging the bot and checking logs, or @userinfobot.
TELEGRAM_CHAT_ID=

# ===== Mini App (Telegram Web App) =====
# Public HTTPS address of the app. When set, the chat gets the "Open" button
# (menu button) and the interactive lists move into the app; the chat itself
# only carries notifications. Telegram requires HTTPS with a valid certificate.
#
# DuckDNS example: create narxoz-bot <https://www.duckdns.org>, point it at the
# VDS IP, then:
#   WEBAPP_DOMAIN=narxoz-bot.duckdns.org
#   WEBAPP_URL=https://narxoz-bot.duckdns.org
WEBAPP_DOMAIN=
WEBAPP_URL=

# Local listen address inside the container (Caddy proxies to it).
WEBAPP_ADDR=:8080

# Development only: authenticate a local browser as this chat without Telegram
# initData. NEVER set it on a public deployment.
# WEBAPP_DEV_CHAT_ID=869865322

# Self-hosted Telegram Bot API endpoint (must contain two %s: token and method).
# Leave empty to use https://api.telegram.org.
# TELEGRAM_API_ENDPOINT=http://127.0.0.1:8081/bot%s/%s

# How often to poll Canvas for changes and reminders.
POLL_INTERVAL=5m
REMINDER_INTERVAL=30m

# Early-reminder lead time in hours: 6, 12 or 24.
REMINDER_LEAD=24

# Timezone used to display all deadlines (Asia/Almaty = UTC+5).
TZ=Asia/Almaty

# Logging: debug | info | warn | error
LOG_LEVEL=info

# SQLite database path (./bot.db locally, /data/bot.db in Docker).
# docker-compose.yml overrides it with /data/bot.db, so this value is only
# used when the bot is started directly (make run / go run ./cmd/bot).
DB_PATH=./bot.db

# Per-request timeout against Canvas / Telegram.
REQUEST_TIMEOUT=30s
